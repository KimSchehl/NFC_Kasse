# NFC-Kasse Konfiguration
# Diese Datei nach Änderungen speichern und den Dienst/Server neu starten,
# damit die Änderungen wirksam werden.

# ---------------------------------------------------------------------------
# Netzwerk
# ---------------------------------------------------------------------------

# Netzwerkschnittstelle, auf die gelauscht wird (0.0.0.0 = alle Schnittstellen).
HOST=0.0.0.0

# Port, auf dem das Backend lauscht.
PORT=8000

# ---------------------------------------------------------------------------
# Sicherheit / Installation
# ---------------------------------------------------------------------------

# Geheimer Schlüssel zum Signieren der Login-Tokens (JWT). Einmalig automatisch
# erzeugt. WICHTIG: Ändern beendet alle aktuell angemeldeten Sitzungen.
SECRET_KEY={secret_key}

# Eindeutige Installations-ID, einmalig erzeugt. NICHT ändern -- jeder
# Feature-Lizenzschlüssel (PAGER, LEADERBOARD, ...) ist auf genau diese ID
# ausgestellt. Wird benötigt, um Lizenzschlüssel anzufordern.
INSTALLATION_ID={installation_id}

# ---------------------------------------------------------------------------
# Veranstaltung
# ---------------------------------------------------------------------------

# Name der Veranstaltung -- erscheint in der App und auf gedruckten Bons.
EVENT_NAME=Hauptveranstaltung

# Chip-Pfand in Euro (z.B. 3.00). Wird beim ersten Ausgeben eines Chips
# automatisch abgebucht und bei Auszahlung automatisch zurückerstattet.
# 0 deaktiviert die Pfand-Logik komplett.
CHIP_DEPOSIT=3.00

# Virtuelle Chip-UID für Bar-Verkäufe ohne physischen NFC-Chip (z.B. an einem
# Backup-Stand ohne Kartenleser). Der Saldo darf hier ins Minus laufen
# (sammelt Bar-Umsätze als Schuldenzähler).
BAR_CHIP_UID=BAR

# ---------------------------------------------------------------------------
# Kostenpflichtige Zusatz-Features
# ---------------------------------------------------------------------------

# Leaderboard-Feature. true = aktiviert -- benötigt zusätzlich einen gültigen
# LEADERBOARD_LICENSE_KEY (siehe INSTALLATION_ID oben) für diese Installation.
LEADERBOARD=false
LEADERBOARD_LICENSE_KEY=

# Pager-Feature. true = aktiviert -- benötigt zusätzlich einen gültigen
# PAGER_LICENSE_KEY (siehe INSTALLATION_ID oben) für diese Installation.
PAGER=false
PAGER_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Web / Netzwerk-Zugriff
# ---------------------------------------------------------------------------

# URL-Pfad, unter dem die Flutter Web App ausgeliefert wird (nur aktiv, wenn
# ein webapp-Ordner neben dem Programm liegt).
WEBAPP_ROUTE=/webapp

# Kommagetrennte Liste erlaubter Herkunfts-Adressen (CORS) für Zugriffe aus
# dem Browser, z.B. "http://192.168.1.50:8000,http://localhost:8000".
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Protokoll-Ausführlichkeit beim Start (TRACE|DEBUG|INFO|WARNING|ERROR|FATAL).
# Kann auch ohne Neustart über die Protokolle-Seite in der App geändert werden.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Bondrucker (ESC/POS)
# ---------------------------------------------------------------------------

# PRINTER_TYPE: 'serial' -- USB-zu-Seriell-Adapter (z.B. Epson TM-T88II)
#               'network' -- TCP/IP, LAN- oder Bluetooth-zu-Seriell-Bridge
PRINTER_TYPE=serial

# Seriell: COM-Port, z.B. COM3
# Netzwerk: TCP-Port, Standard für ESC/POS: 9100
PRINTER_PORT=COM4

# Baudrate für seriellen Anschluss (TM-T88II Standard: 9600).
PRINTER_BAUDRATE=9600

# IP-Adresse des Druckers, nur bei PRINTER_TYPE=network.
PRINTER_HOST=192.168.1.100

# Zeichen pro Zeile bei normaler Schriftgröße (80mm Papier = 42).
PRINTER_LINE_WIDTH=42

# Bon nach dem Druck automatisch abschneiden.
PRINTER_AUTO_CUT=true

# ---------------------------------------------------------------------------
# Bon-Inhalt (das eigentliche Layout -- Trennlinien, Fett, Papiervorschub --
# steht vorerst in bon.yaml, bis dafür ein eigenes visuelles Design-Tool
# kommt; volle Befehlsreferenz + Beispiele dazu in bon_template.yaml. Hier
# nur die reinen Sichtbarkeits-/Inhalts-Schalter.)
# ---------------------------------------------------------------------------

# Veranstaltungsname auf dem Bon anzeigen.
BON_SHOW_EVENT_NAME=true

# Datum + Uhrzeit auf dem Bon anzeigen.
BON_SHOW_DATETIME=true

# Preis auf dem Bon anzeigen.
BON_SHOW_PRICE=true

# Optionaler Text unter dem Artikel, z.B. "Vielen Dank!". Leer = kein Text.
BON_FOOTER_TEXT=

# Namen des Kassierers/der Kassiererin auf dem Bon anzeigen.
BON_SHOW_CASHIER=true

# Bezeichnung vor dem Kassierer-Namen. Leer lassen für nur den Namen.
BON_CASHIER_LABEL=Kassierer
